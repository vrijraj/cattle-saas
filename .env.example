# ---------------------------------------------------------------------------
# Core Database & Auth
# ---------------------------------------------------------------------------
# Local development uses embedded PGlite (no Docker needed):
DATABASE_URL=pglite:.data/pglite
# Production PostgreSQL 16 example:
# DATABASE_URL=postgres://cattle:strong-password@db:5432/cattle

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3007

# ---------------------------------------------------------------------------
# File Storage (Cloudflare R2 or S3-compatible)
# Local dev falls back to .data/storage when R2 variables are empty.
# Required in production for animal/bull/product photos and vet attachments.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_PRIVATE=cattle-private
R2_BUCKET_PUBLIC=cattle-public
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Transactional Email (ZeptoMail)
# Used for staff invites, password resets, public enquiry notifications,
# daily farm digests, and plan upgrade requests.
# ---------------------------------------------------------------------------
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
PLATFORM_BILLING_EMAIL=

# ---------------------------------------------------------------------------
# Razorpay (Public Storefront Orders + Recurring SaaS Subscriptions)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Razorpay Plan IDs to enable live self-serve SaaS upgrades:
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ENTERPRISE=

# ---------------------------------------------------------------------------
# Google Gemini AI Assistant (@google/adk)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Daily Automation Cron (/api/cron/daily)
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API & SMS Alerts (/api/webhooks/whatsapp)
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
SMS_TOKEN=
SMS_API_URL=
