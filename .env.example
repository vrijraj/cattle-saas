# Embedded Postgres for local development. No Docker required.
# For a Postgres server, use postgres://cattle:cattle@localhost:5432/cattle
DATABASE_URL=pglite:.data/pglite
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3007

# Cloudflare R2. Animal create works without these; photo upload needs them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_PRIVATE=cattle-private
R2_BUCKET_PUBLIC=cattle-public
R2_PUBLIC_BASE_URL=

# ZeptoMail. Invites copy a link when this is empty.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

# Razorpay. Empty keys leave shop orders at pending payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini, used by the Assistant page through Google ADK. Leave empty to show the setup note.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
